{
  "name": "@gtd/desktop",
  "version": "0.6.0",
  "description": "本地优先的 GTD 任务清单应用（桌面端）",
  "author": "GTD 清单",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --external:electron --external:better-sqlite3 --outfile=dist-electron/main.js && esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.js",
    "sync-renderer": "node scripts/sync-renderer.mjs",
    "build": "bun run build:main && bun run sync-renderer",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dev": "bun run build:main && electron . --dev",
    "smoke": "bun run build && electron . --smoke",
    "verify:sqlite": "electron scripts/verify-sqlite.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "electron": "43.8.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}